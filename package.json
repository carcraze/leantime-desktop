{
  "name": "leantime-desktop",
  "productName": "Leantime Desktop",
  "version": "0.1.0",
  "description": "Unofficial desktop client for Leantime project management",
  "main": "src/main.js",
  "//desktopName": "Electron derives app_id (and therefore WM_CLASS) from this. It must match the installed .desktop filename or desktop environments cannot associate the running window with its launcher entry.",
  "desktopName": "io.github.leantimedesktop.app",
  "license": "AGPL-3.0-only",
  "private": true,
  "homepage": "https://github.com/leantime-desktop/leantime-desktop",
  "author": {
    "name": "Leantime Desktop Contributors",
    "email": "noreply@example.com"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "lint": "node --check src/main.js && node --check src/preload.js && node --check src/store.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:integration": "node --test --test-timeout=60000 \"tests/integration/*.test.js\"",
    "test:all": "npm test && npm run test:integration",
    "dist:snap:core22": "electron-builder --linux snap --config electron-builder.core22.yml"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "^26.15.7"
  },
  "allowScripts": {
    "electron@38.2.2": true
  }
}
